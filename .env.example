# crypt-chat deployment config.
# Copy this to `.env` and adjust to taste.

# Owner of the GHCR image. With the default GitHub Actions workflow this is
# the lowercase GitHub username/org that owns the repo.
IMAGE_OWNER=yinmo19

# Image tag to pull. `latest` always points at the most recent green build
# of the default branch. Pin to a SHA-based tag for reproducible deploys.
IMAGE_TAG=latest

# Host port that crypt-chat will bind to. Put this behind your reverse
# proxy (nginx/Caddy) for TLS termination. The container always listens
# on 8080 internally.
HOST_PORT=8080
